# Gemini API key (required in Milestone 2 for GeminiTtsProvider; not needed for Milestone 1 tests)
GEMINI_API_KEY=

# Directory for projects, takes, exports, and reusable assets
DATA_DIR=./data

# HTTP API port (Milestone 2)
PORT=3480

# Optional custom paths to ffmpeg / ffprobe binaries (defaults to PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Default TTS model, Director multimodal model & safety threshold
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_DIRECTOR_MODEL=gemini-3.5-flash
GEMINI_SAFETY_THRESHOLD=off
