# Gemini API key (required in Milestone 2 for GeminiTtsProvider; not needed for Milestone 1 tests)
GEMINI_API_KEY=

# Directory for projects, takes, exports, and reusable assets
DATA_DIR=./data

# HTTP API port (Milestone 2)
PORT=3480

# Optional custom paths to ffmpeg / ffprobe binaries (defaults to PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Default TTS model, Director multimodal model & safety threshold
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_DIRECTOR_MODEL=gemini-3.5-flash
GEMINI_SAFETY_THRESHOLD=off

# Optional delimiter-separated root directories allowed for booth_mix outputPath delivery
# (unset = allow any local audio file destination with .ogg/.wav/.mp3 extension)
# ALLOWED_EXPORT_DIRS=

# Optional path.delimiter-separated external read-only SFX/bed library roots.
# Supports optional "alias=path" prefixes; otherwise auto-slugs the folder basename.
# Windows uses ';', macOS/Linux uses ':'
# ASSET_LIBRARY_DIRS=sonniss=D:/SFX/SonnissGDC;nps=D:/SFX/NPS_Nature;cc0=D:/SFX/FreesoundCC0

# Optional embedding model & Matryoshka dimension for hybrid semantic asset search
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
ASSET_EMBEDDING_DIMS=256
